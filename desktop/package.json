{
  "name": "oir-viewer-desktop",
  "productName": "OIR Viewer",
  "version": "1.0.1",
  "description": "Viewer for Olympus .oir and other microscopy image stacks",
  "main": "main.js",
  "private": true,
  "author": "Y. Kobayashi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "jp.ykobayashi.oirviewer",
    "productName": "OIR Viewer",
    "directories": {
      "output": "../release",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.medical",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Science"
    }
  }
}
